import asyncio
from playwright.async_api import async_playwright

# --- CONFIGURATION ---
TARGET_URL = "https://your-blocked-site.com" 
# ---------------------

async def run_xray_with_login():
    async with async_playwright() as p:
        print("1. Launching Browser...")
        # Launch visible browser (headless=False) so you can login
        browser = await p.chromium.launch(
            headless=False,
            channel="chrome",
            args=["--disable-blink-features=AutomationControlled", "--no-sandbox"]
        )
        
        # Setup stealth context
        context = await browser.new_context(viewport={"width": 1920, "height": 3000})
        await context.add_init_script("Object.defineProperty(navigator, 'webdriver', {get: () => undefined})")
        
        page = await context.new_page()

        print(f"2. Navigating to {TARGET_URL}...")
        try:
            await page.goto(TARGET_URL, timeout=60000)
        except:
            print("Page loaded (or timed out), continuing...")

        # ============================================================
        # THE LOGIN PAUSE
        # ============================================================
        print("\n" + "="*50)
        print("ACTION REQUIRED: Log in manually in the opened window.")
        print("Navigate to the dashboard where you see 'POS' and 'ATM'.")
        input(">>> WHEN YOU ARE READY, CLICK HERE AND PRESS ENTER <<<")
        print("="*50 + "\n")
        # ============================================================

        print("3. Analyzing page structure (X-Ray Vision)...")

        # INJECT JAVASCRIPT TO DRAW BOXES
        await page.evaluate("""() => {
            // Find all potential containers
            const elements = document.querySelectorAll('div, section, article, table, tr');
            
            elements.forEach(el => {
                const rect = el.getBoundingClientRect();
                // Filter out tiny invisible elements
                if (rect.width > 50 && rect.height > 50) {
                    
                    let color = 'red'; // Default color
                    let text = el.innerText.toUpperCase();
                    
                    // HIGHLIGHT 'POS' or 'ATM' SPECIFICALLY
                    if (text.includes('POS') || text.includes('ATM')) {
                        color = '#00ff00'; // Bright Green for your targets
                        el.style.boxShadow = '0px 0px 10px #00ff00';
                    }

                    // Draw Border
                    el.style.border = `2px solid ${color}`;
                    el.style.position = 'relative';

                    // Create Label
                    const label = document.createElement('span');
                    
                    // Build Selector Name (e.g., div#dashboard-wrapper)
                    let name = el.tagName.toLowerCase();
                    if (el.id) name += '#' + el.id;
                    if (el.className && typeof el.className === 'string' && el.className.length > 0) {
                         name += '.' + el.className.split(' ')[0];
                    }

                    label.innerText = name;
                    
                    // Style the Label
                    label.style.position = 'absolute';
                    label.style.top = '0';
                    label.style.left = '0';
                    label.style.background = color;
                    label.style.color = 'black';
                    label.style.fontSize = '12px';
                    label.style.fontWeight = 'bold';
                    label.style.zIndex = '10000';
                    label.style.padding = '2px';
                    
                    // Only append label if it doesn't already have one
                    if (!el.getAttribute('data-xray')) {
                        el.setAttribute('data-xray', 'true');
                        el.appendChild(label);
                    }
                }
            });
        }""")

        # Take the Blueprint Screenshot
        filename = "layout_blueprint.png"
        await page.screenshot(path=filename, full_page=True)
        
        print(f"SUCCESS! Map saved to: {filename}")
        print("Open the image. Look for the GREEN or RED boxes around your data.")
        print("The yellow/green tag in the corner is the SELECTOR you need.")

        await browser.close()

if __name__ == "__main__":
    asyncio.run(run_xray_with_login())
