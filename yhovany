import asyncio
import os
from datetime import datetime
from playwright.async_api import async_playwright

# --- CONFIGURATION ---
TARGET_URL = "https://your-blocked-site.com"
TARGET_SELECTOR = "#dashboard-wrapper"  # <--- From your X-Ray results
FOLDER_NAME = "screenshots"
CHECK_INTERVAL = 60
# ---------------------

async def run_manual_login_monitor():
    if not os.path.exists(FOLDER_NAME):
        os.makedirs(FOLDER_NAME)

    async with async_playwright() as p:
        print("1. Launching Browser...")
        
        # Launch non-headless so you can see and interact
        browser = await p.chromium.launch(
            headless=False, 
            channel="chrome",
            args=["--disable-blink-features=AutomationControlled", "--no-sandbox"]
        )
        
        # Setup context
        context = await browser.new_context(viewport={"width": 1920, "height": 1080})
        await context.add_init_script("Object.defineProperty(navigator, 'webdriver', {get: () => undefined})")
        
        page = await context.new_page()

        print(f"2. Navigating to {TARGET_URL}...")
        try:
            await page.goto(TARGET_URL, timeout=60000)
        except:
            print("Page loaded (or timed out), continuing...")

        # ============================================================
        # THE PAUSE BUTTON
        # ============================================================
        print("\n" + "="*50)
        print("ACTION REQUIRED: Log in manually in the browser window.")
        print("Navigate to the dashboard where the graphs are visible.")
        input(">>> WHEN YOU ARE READY, CLICK HERE AND PRESS ENTER <<<")
        print("="*50 + "\n")
        # ============================================================

        print("3. Resuming automation... Searching for target element.")

        try:
            # Wait for your graph to ensure we are actually on the right page
            await page.wait_for_selector(TARGET_SELECTOR, state="visible", timeout=10000)
            print(f"Target '{TARGET_SELECTOR}' found! Starting screenshot loop.")
            
            while True:
                timestamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
                filename = f"{FOLDER_NAME}/graph_{timestamp}.png"
                
                # Screenshot specific element
                await page.locator(TARGET_SELECTOR).screenshot(path=filename)
                print(f"[{timestamp}] Saved: {filename}")
                
                await asyncio.sleep(CHECK_INTERVAL)
                
                # Optional: Reload page to update data
                # Comment this out if the site updates automatically via WebSocket
                try:
                    await page.reload(wait_until="domcontentloaded")
                    await page.wait_for_selector(TARGET_SELECTOR, timeout=10000)
                except:
                    print("Reload took too long, skipping...")

        except Exception as e:
            print(f"Error: Could not find '{TARGET_SELECTOR}' after you pressed Enter.")
            print(f"Details: {e}")
            # Take a debug picture to see what the script sees
            await page.screenshot(path="debug_error.png", full_page=True)

        finally:
            await browser.close()

if __name__ == "__main__":
    try:
        # Create a new event loop just for this run
        asyncio.run(run_manual_login_monitor())
    except KeyboardInterrupt:
        print("\nStopped.")
