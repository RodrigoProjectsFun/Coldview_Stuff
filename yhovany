import asyncio
from playwright.async_api import async_playwright

TARGET_URL = "https://your-blocked-site.com"

async def run_stealth():
    async with async_playwright() as p:
        # Launch with special "Stealth" arguments
        browser = await p.chromium.launch(
            headless=False,  # Headless mode is often blocked; try False first
            channel="chrome", # Use your real Chrome browser (looks more human)
            args=[
                "--disable-blink-features=AutomationControlled", # <--- THE KEY COMMAND
                "--no-sandbox",
                "--user-agent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36" # Fake a standard user agent
            ]
        )
        
        # Create a context with extra stealth settings
        context = await browser.new_context(
            user_agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
            viewport={"width": 1920, "height": 1080}
        )
        
        # Apply a script to delete the 'webdriver' property from the browser
        await context.add_init_script("Object.defineProperty(navigator, 'webdriver', {get: () => undefined})")

        page = await context.new_page()
        
        print("Attempting stealth navigation...")
        await page.goto(TARGET_URL)
        
        # Take a screenshot to verify success
        await page.screenshot(path="stealth_check.png")
        print("Screenshot saved.")
        
        await asyncio.sleep(10) # Keep open to check manually
        await browser.close()

if __name__ == "__main__":
    asyncio.run(run_stealth())
