import subprocess
import pandas as pd
import os
import sys

def get_resource_path(relative_path):
    """Gets the absolute path to a resource for PyInstaller compatibility."""
    try:
        base_path = sys._MEIPASS
    except Exception:
        base_path = os.path.abspath(".")
    return os.path.join(base_path, relative_path)

def run_executable(exe_path, args=None):
    """Runs the external executable."""
    command = [exe_path]
    if args:
        command.extend(args)
    
    print("Generating text files...")
    try:
        subprocess.run(command, check=True, capture_output=True, text=True)
    except subprocess.CalledProcessError as e:
        print(f"Error: The executable failed.\n{e.stderr}")
        sys.exit(1)
    except FileNotFoundError:
        print(f"Error: Could not find the executable at '{exe_path}'.")
        sys.exit(1)

def process_and_cleanup(txt_file1, txt_file2, output_excel, column_names):
    """Reads fixed-width text files, merges them, and saves to Excel."""
    if not os.path.exists(txt_file1) or not os.path.exists(txt_file2):
        print("Error: The text files were not generated properly.")
        sys.exit(1)

    print("Reading aligned text files and converting to Excel...")
    try:
        # read_fwf automatically detects the visual column alignment
        # names=column_names applies your custom headers to the top
        df1 = pd.read_fwf(txt_file1, names=column_names) 
        df2 = pd.read_fwf(txt_file2, names=column_names)

        # Stack the two dataframes vertically
        # ignore_index=True ensures the row numbers reset cleanly from top to bottom
        combined_df = pd.concat([df1, df2], axis=0, ignore_index=True)

        # Write the combined data to a single sheet
        combined_df.to_excel(output_excel, index=False, sheet_name='Combined Data')
            
        print(f"Success! Excel file created: {output_excel}")

        # --- CLEAN UP PHASE ---
        print("Cleaning up temporary text files...")
        os.remove(txt_file1)
        os.remove(txt_file2)
        print("Cleanup complete.")

    except Exception as e:
        print(f"An error occurred during conversion or cleanup: {e}")

if __name__ == "__main__":
    # --- CONFIGURATION ---
    EXE_NAME = "your_program.exe" 
    EXECUTABLE_PATH = get_resource_path(EXE_NAME) 
    EXECUTABLE_ARGS = [] 
    
    TEXT_FILE_1 = "output1.txt" 
    TEXT_FILE_2 = "output2.txt" 
    EXCEL_OUTPUT = "Combined_Results.xlsx"
    
    # Define your shared column names here
    SHARED_COLUMNS = ["Column_A", "Column_B", "Column_C", "Column_D"] 
    # ---------------------

    run_executable(EXECUTABLE_PATH, EXECUTABLE_ARGS)
    process_and_cleanup(TEXT_FILE_1, TEXT_FILE_2, EXCEL_OUTPUT, SHARED_COLUMNS)
