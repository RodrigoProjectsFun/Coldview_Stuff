graph TD
    %% --- EL PROBLEMA DE ORIGEN ---
    subgraph Origen ["M2D PROBLEMATICA"]
        B1["Operaciones (B1)<br/>(Individuales)"]
        B2["Confirmaciones (B2)<br/>(Se agrupan por mismo Num Ope)"]
        
        B1 -- "Deberían conciliar con" --> B2
        B2 -.->|"❌ NO CONCILIA<br/>(Montos no coinciden)"| B1
    end

    %% --- LA SEPARACIÓN ---
    B1 --> Camino_B1
    B2 --> Camino_B2

    %% --- CAMINO IZQUIERDO: B1 (DEUDA) ---
    subgraph Ruta_B1 ["Ruta B1 (Autorizaciones)"]
        direction TB
        Camino_B1("B1 sin conciliación")
        
        Camino_B1 -->|Espera 2 Días| I21["<b>REPORTE M2D (I21)</b><br/>Recuperación de Abono"]
    end

    %% --- CAMINO DERECHO: B2 (DINERO) ---
    subgraph Ruta_B2 ["Ruta B2 (Abonos)"]
        direction TB
        Camino_B2("B2 no conciliado")
        
        Camino_B2 --> I16["<b>REPORTE (I16)</b><br/>(Sala de Espera)"]
        I16 -->|Espera 6 Días| I22["<b>REPORTE M6D (I22)</b><br/>Abonos no aplicados"]
    end

    %% Estilos simples
    classDef error fill:#ffcdd2,stroke:#b71c1c,stroke-width:2px;
    classDef wait fill:#fff9c4,stroke:#fbc02d,stroke-width:2px;
    classDef normal fill:#e1f5fe,stroke:#01579b,stroke-width:2px;

    class I21,I22 error;
    class I16 wait;
    class B1,B2 normal;
