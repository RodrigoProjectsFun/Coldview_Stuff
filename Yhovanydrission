import os
import logging
import time
from datetime import datetime, timedelta
from urllib.parse import urlparse
from DrissionPage import ChromiumPage, ChromiumOptions
import httpx

# --- CONFIGURACIÓN ---
URL_OBJETIVO = "https://www.google.com"  # Cambiar a tu sitio objetivo
INTERVALO = 5                      # Segundos entre capturas de pantalla
NOMBRE_CARPETA = "screenshots"
DURACION_MAXIMA_MINUTOS = 120      # Duración máxima de ejecución (2 horas)
MAX_REINTENTOS = 3                 # Número máximo de reintentos
BACKOFF_INICIAL = 2                # Segundos iniciales para backoff exponencial
# ---------------------

# --- CONFIGURACIÓN DE LOGGING ---
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler('grafana_screens.log', encoding='utf-8'),
        logging.StreamHandler()
    ]
)
logger = logging.getLogger(__name__)
# ---------------------------------

def validar_url(url: str) -> bool:
    """
    Valida que la URL tenga un formato correcto y sea accesible.
    """
    # 1. Validar formato de URL
    try:
        resultado = urlparse(url)
        if not all([resultado.scheme, resultado.netloc]):
            logger.error(f"URL con formato inválido: {url}")
            return False
        if resultado.scheme not in ['http', 'https']:
            logger.error(f"Esquema de URL no soportado: {resultado.scheme}")
            return False
    except Exception as e:
        logger.error(f"Error al parsear URL: {e}")
        return False
    
    # 2. Verificar accesibilidad (Usamos httpx para no abrir el navegador aun)
    logger.info(f"Verificando accesibilidad de {url}...")
    try:
        with httpx.Client(timeout=10.0) as client:
            response = client.head(url, follow_redirects=True)
            if response.status_code < 400:
                logger.info(f"URL accesible (código: {response.status_code})")
                return True
            else:
                logger.warning(f"URL respondió con código de error: {response.status_code}")
                return False
    except Exception as e:
        logger.error(f"Error al verificar URL: {e}")
        return False

def navegar_con_reintentos(page: ChromiumPage, url: str, max_reintentos: int = MAX_REINTENTOS) -> bool:
    """
    Navega a una URL con reintentos y backoff exponencial usando DrissionPage.
    """
    for intento in range(max_reintentos):
        try:
            logger.info(f"Intento {intento + 1}/{max_reintentos}: Navegando a {url}...")
            
            # DrissionPage: .get() carga la página
            page.get(url, retry=0, timeout=30) 
            
            # Verificación básica de que cargó (si existe el body)
            if page.ele('tag:body'):
                logger.info("Página cargada exitosamente")
                return True
            else:
                raise Exception("El cuerpo de la página no se detectó.")

        except Exception as e:
            tiempo_espera = BACKOFF_INICIAL * (2 ** intento)
            logger.warning(f"Intento {intento + 1} fallido: {e}")
            
            if intento < max_reintentos - 1:
                logger.info(f"Esperando {tiempo_espera} segundos antes de reintentar...")
                time.sleep(tiempo_espera) # Sleep síncrono
            else:
                logger.error(f"Todos los reintentos agotados. No se pudo cargar: {url}")
                return False
    
    return False

def tomar_captura_con_reintentos(page: ChromiumPage, nombre_archivo: str, max_reintentos: int = 3) -> bool:
    """
    Toma una captura de pantalla con reintentos usando DrissionPage.
    """
    for intento in range(max_reintentos):
        try:
            # DrissionPage: get_screenshot guarda el archivo
            # path espera la ruta completa o carpeta. Si termina en extensión, lo usa como nombre.
            page.get_screenshot(path=nombre_archivo, full_page=False)
            
            # Verificamos si el archivo se creó realmente
            if os.path.exists(nombre_archivo):
                return True
            else:
                raise Exception("El archivo de captura no se generó.")
                
        except Exception as e:
            tiempo_espera = 1 * (2 ** intento)
            logger.warning(f"Error en captura (intento {intento + 1}): {e}")
            
            if intento < max_reintentos - 1:
                time.sleep(tiempo_espera)
            else:
                logger.error(f"No se pudo tomar captura después de {max_reintentos} intentos")
                return False
    
    return False

def ejecutar_monitor_capturas():
    """Función principal (Síncrona para DrissionPage)."""
    
    # 0. Validar URL antes de iniciar
    if not validar_url(URL_OBJETIVO):
        logger.error("La URL no es válida o no es accesible. Abortando.")
        return
    
    # 1. Crear directorio si no existe
    if not os.path.exists(NOMBRE_CARPETA):
        os.makedirs(NOMBRE_CARPETA)
        logger.info(f"Carpeta creada: {NOMBRE_CARPETA}")
    else:
        logger.debug(f"La carpeta ya existe: {NOMBRE_CARPETA}")

    # Calcular tiempo límite
    tiempo_inicio = time.time()
    tiempo_limite = tiempo_inicio + (DURACION_MAXIMA_MINUTOS * 60)
    hora_fin_estimada = datetime.now() + timedelta(minutes=DURACION_MAXIMA_MINUTOS)
    logger.info(f"Duración máxima configurada: {DURACION_MAXIMA_MINUTOS} minutos")
    logger.info(f"El script se detendrá automáticamente a las: {hora_fin_estimada.strftime('%H:%M:%S')}")

    # INICIALIZAR DRISSIONPAGE
    # ChromiumOptions permite configurar argumentos si fuera necesario
    co = ChromiumOptions()
    # co.headless(True) # Descomentar si quieres que no se vea el navegador
    
    logger.info("Iniciando navegador Chromium (DrissionPage)...")
    page = ChromiumPage(co) # Conecta automáticamente al navegador
    
    try:
        logger.info("Navegador iniciado correctamente")

        # Navegar con reintentos
        if not navegar_con_reintentos(page, URL_OBJETIVO):
            page.quit()
            return

        logger.info("Iniciando bucle de capturas. Presiona Ctrl+C para detener.")

        contador_capturas = 0
        capturas_fallidas = 0
        motivo_fin = "desconocido"
        
        while True:
            # Verificar si se alcanzó el tiempo límite
            if time.time() >= tiempo_limite:
                motivo_fin = "duración máxima alcanzada"
                logger.warning(f"Tiempo límite alcanzado ({DURACION_MAXIMA_MINUTOS} minutos). Deteniendo...")
                break
            
            # Calcular tiempo restante
            tiempo_restante = int((tiempo_limite - time.time()) / 60)
            
            # Generar nombre de archivo único
            marca_tiempo = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
            # Usamos os.path.join para mejor compatibilidad de rutas
            nombre_archivo = os.path.join(NOMBRE_CARPETA, f"captura_{marca_tiempo}.png")

            # Tomar la captura
            if tomar_captura_con_reintentos(page, nombre_archivo):
                contador_capturas += 1
                logger.info(f"Captura guardada: {nombre_archivo} (Total: {contador_capturas}, Restante: ~{tiempo_restante}min)")
            else:
                capturas_fallidas += 1
                logger.warning(f"Capturas fallidas acumuladas: {capturas_fallidas}")

            # Esperar antes de la siguiente captura (Sleep síncrono)
            time.sleep(INTERVALO)

    except KeyboardInterrupt:
        motivo_fin = "detenido por el usuario"
        logger.warning("Detenido por el usuario.")
    except Exception as e:
        motivo_fin = f"error inesperado: {e}"
        logger.error(f"Error inesperado en el bucle: {e}")
    finally:
        duracion_total = int((time.time() - tiempo_inicio) / 60)
        logger.info(f"=== RESUMEN DE EJECUCIÓN ===")
        logger.info(f"Motivo de finalización: {motivo_fin}")
        logger.info(f"Duración total: {duracion_total} minutos")
        logger.info(f"Capturas exitosas: {contador_capturas}")
        logger.info(f"Capturas fallidas: {capturas_fallidas}")
        logger.info(f"Cerrando navegador...")
        page.quit()
        logger.info("Navegador cerrado correctamente")

if __name__ == "__main__":
    logger.info("=== Iniciando Monitor de Capturas (DrissionPage) ===")
    try:
        # Ya no necesitamos asyncio.run() porque DrissionPage es síncrono
        ejecutar_monitor_capturas()
    except KeyboardInterrupt:
        pass
    finally:
        logger.info("=== Monitor Finalizado ===")
